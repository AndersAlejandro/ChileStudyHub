<body>
  <nav class="navbar" id="navbar-color">
    <div class="container-fluid navbar-expand-lg">
      <div class="d-flex align-items-center">
        <img src="/img/icononavbar.png" alt="icononavbar" class="navbar-icon">
        <a class="navbar-brand text-light" href="#">ChileStudyHub</a>
      </div>
      <div class="ms-auto d-flex flex-column text-end ">
        <h5 class="text-light">Bienvenido: {{decode.nombre}}</h5>
        <div class="d-flex align-items-center">
          <p class="mb-0 me-2">Rol: {{decode.tipo_usuario}}</p>
          <div class="dropdown">
            <button class="btn btn-outline-light dropdown-toggle" type="button" id="dropdownMenuButton1"
              data-bs-toggle="dropdown" aria-expanded="false">
              Opciones
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
              {{#eq decode.tipo_usuario 'admin'}}
              <li><a class="dropdown-item" href="/crearCurso">Crear curso</a></li>
              {{/eq}}
              <li><a class="dropdown-item" href="/">Salir</a></li>
              {{#eq decode.tipo_usuario 'estudiante'}}
              <li><a class="dropdown-item" href="/inscripciones">Ver cursos inscritos</a></li>
              {{/eq}}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </nav>


  <main class="main-content">
    <div class="container my-4">
      <form id="filtroForm" method="GET" action="/cursos">
        <select name="area" id="filterArea" class="form-select w-25 mx-auto" onchange="this.form.submit()">
          <option value="">Cursos</option>
          {{#each areaCurso}}
          <option value="{{this.id}}">{{this.nombre}}</option>
          {{/each}}
          <option value="">Todas las áreas</option>
        </select>
      </form>
    </div>

    <div class="container my-5">
      <div class="row justify-content-center g-4">
        {{#each cursos}}
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex justify-content-center">
          <div class="card" style="max-width: 320px; width: 100%;">
            <img src="{{this.portada}}" class="card-img-top" alt="Portada del Curso">
            <div class="card-body d-flex flex-column">
              <h2 class="card-title">{{this.nombre}}</h2>
              <p class="card-text">{{this.descripcion}}</p>
              <a href="/curso/{{this.id}}" class="btn btn-warning text-light mt-auto">Ver más</a>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </main>

  <footer class="text-center mt-4">
    <p class="mb-1">&copy; 2024 ChileStudyHub - Todos los derechos reservados</p>
  </footer>

  <script src="js/curso.js"></script>
</body>
