<body>
  <nav class="navbar" id="navbar-color">
    <div class="container-fluid navbar-expand-lg">
      <div class="d-flex align-items-center">
        <img src="/img/icononavbar.png" alt="icononavbar" class="navbar-icon" />
        <a class="navbar-brand text-light" href="#">ChileStudyHub</a>
      </div>
      <div class="ms-auto d-flex flex-column text-end">
        <h5 class="text-light">Bienvenido: {{decode.nombre}}</h5>
        <div class="d-flex align-items-center">
          <p class="mb-0 me-2">Rol: {{decode.tipo_usuario}}</p>
          <div class="dropdown">
            <button
              class="btn btn-outline-light dropdown-toggle"
              type="button"
              id="dropdownMenuButton1"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              Opciones
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
              {{#eq decode.tipo_usuario "admin"}}
                <li><a class="dropdown-item" href="/crearCurso">Crear curso</a></li>
              {{/eq}}
              <li><a class="dropdown-item" href="/">Salir</a></li>
              {{#eq decode.tipo_usuario "estudiante"}}
                <li><a class="dropdown-item" href="/inscripciones">Ver cursos
                    inscritos</a></li>
              {{/eq}}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main class="main-content">
    <section class="container">

      <div class="filtro-container">
        <div class="filtro-busqueda">
          <input
            id="buscador"
            type="text"
            class="filtro-input"
            placeholder="Buscar cursos..."
          />
          <button
            id="btnClear"
            class="filtro-clear-btn"
            title="Limpiar búsqueda"
          >×</button>
        </div>

        <div style="position: relative; display: inline-block;">
          <button
            id="btnCategoria"
            class="btn-filtro"
            aria-expanded="false"
            aria-haspopup="true"
            type="button"
          >
            Categorías ▼
          </button>
          <div
            id="listaCategorias"
            class="dropdown-categorias"
            role="menu"
            aria-labelledby="btnCategoria"
          >
            {{#each areaCurso}}
              <div class="categoria-item">
                <input
                  type="checkbox"
                  id="cat-{{this.id}}"
                  data-id="{{this.id}}"
                  class="categoria-checkbox"
                />
                <label for="cat-{{this.id}}">{{this.nombre}}</label>
              </div>
            {{/each}}
          </div>
        </div>

        <div id="categoriasSeleccionadas" style="margin-top: 10px;"></div>
      </div>

      <div id="listaCursos" class="cursos-container">
        {{#each cursos}}
          <div class="curso-item" data-area="{{this.id_area}}">
            <div class="img-container">

              <img src="{{this.portada}}" alt="Portada curso" />
            </div>
            <div class="curso-body">
              <h3>{{this.nombre}}</h3>
              <p class="card-text">{{this.descripcion}}</p>
              <a href="/curso/{{this.id}}">Ver más</a>
            </div>
          </div>
        {{/each}}
      </div>

    </section>
  </main>

  <script src="js/curso.js"></script>
</body>